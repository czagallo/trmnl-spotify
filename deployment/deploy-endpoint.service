[Unit]
Description=TRMNL Spotify Deployment Endpoint
After=network.target

[Service]
Type=simple
User=antfarm
Group=antfarm
WorkingDirectory=/home/antfarm/deployments/trmnl-spotify
Environment="NODE_ENV=production"
Environment="DEPLOY_PORT=3008"
# Generate with: openssl rand -hex 32
# Set the real token on the server only — do not commit it
Environment="DEPLOY_TOKEN=your-secure-token-here"

ExecStart=/usr/bin/node /home/antfarm/deployments/trmnl-spotify/deployment/deploy-endpoint.js

Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
